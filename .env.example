# ============================================================
# FRONTEND ENVIRONMENT VARIABLES
# Copy this file to .env (local dev) or .env.local and fill in values.
# VITE_* variables are bundled into the frontend build — never put secrets here.
# ============================================================

# Supabase project URL (from Supabase dashboard → Project Settings → API)
VITE_SUPABASE_URL=https://<project-ref>.supabase.co

# Supabase anon/publishable key — safe to expose in the browser
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<key>

# Supabase project ref (used internally for local vs hosted detection)
VITE_SUPABASE_PROJECT_ID=<project-ref>

# Auth mode: "otp" (email OTP via send-otp-email function) | "magic-link" (Supabase magic link)
VITE_AUTH_VERIFICATION_MODE=otp

# Payment provider: "paypal" | "paystack"
VITE_PAYMENT_SWITCH=paypal

# Payment flow intent: "1" = CAPTURE (charge immediately) | "2" = AUTHORIZE (charge later)
VITE_PAYMENT_INTENT=1


# ============================================================
# EDGE FUNCTION SECRETS
# Set these in Supabase dashboard → Settings → Edge Functions → Secrets.
# Never commit real values. These are NOT available in the frontend build.
# ============================================================

# ── Supabase (auto-injected at runtime — set manually for local dev with supabase CLI) ──
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# ── App ──
# Public URL of the frontend, used to build redirect links in emails
CLIENT_BASEURL=https://yourdomain.com

# ── Email (Resend) ──
# API key from resend.com dashboard
RESEND_API_KEY=re_<key>
# Verified sender address — must match a domain verified in Resend
SENDER_EMAIL=noreply@yourdomain.com

# ── PayPal ──
# Sandbox: https://api-m.sandbox.paypal.com  |  Live: https://api-m.paypal.com
PAYPAL_API=https://api-m.sandbox.paypal.com
PAYPAL_API_CLIENT=<paypal-client-id>
PAYPAL_API_SECRET=<paypal-client-secret>
# Webhook ID from PayPal developer dashboard → Webhooks
PAYPAL_WEBHOOK_ID=<paypal-webhook-id>

# ── Zettle (iZettle) ──
ZETTLE_CLIENT_ID=<zettle-client-id>
# JWT bearer assertion secret from Zettle developer portal
ZETTLE_CLIENT_SECRET=<zettle-jwt-secret>
# Contact email registered with the Zettle webhook subscription
ZETTLE_CONTACT_EMAIL=contact@yourdomain.com
# Webhook signing key from Zettle developer portal → Webhooks
ZETTLE_WEBHOOK_SIGNING_KEY=<zettle-webhook-signing-key>

# ── CORS ──
# Comma-separated list of allowed origins for edge function responses
# In production set to your exact frontend URL (no trailing slash)
ALLOWED_ORIGIN=https://yourdomain.com

# ── Cron security ──
# Shared secret used to authenticate Supabase Scheduler → edge function calls.
# Generate with: openssl rand -hex 32
# Include as `Authorization: Bearer <value>` in your pg_cron / Scheduler job.
CRON_SECRET=<random-hex-secret>
